   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# SAM-VMNet Inference & Evaluation\n",
    "\n",
    "Evaluate fine-tuned SAM-VMNet and compare with other 4 approaches.\n",
    "\n",
    "**Time:** ~20-30 minutes"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 1: Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "import json\n",
    "import sys\n",
    "import os\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "from PIL import Image, ImageDraw\n",
    "import matplotlib.pyplot as plt\n",
    "from tqdm import tqdm\n",
    "\n",
    "# === BASE_URL CONFIGURATION ===\n",
    "BASE_URL = \"/content/drive/MyDrive/experiments\"  # Colab\n",
    "# BASE_URL = \"D:/MPHIL_CODES/MPHIL_MAIN_REPO/experiments\"  # Windows\n",
    "\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "IMAGE_SIZE = 512\n",
    "\n",
    "# Auto-mount Drive on Colab\n",
    "IS_COLAB = 'google.colab' in sys.modules\n",
    "if IS_COLAB:\n",
    "    from google.colab import drive\n",
    "    drive.mount('/content/drive', force_remount=False)\n",
    "\n",
    "print(f\"✓ Configuration loaded\")\n",
    "print(f\"  BASE_URL: {BASE_URL}\")\n",
    "print(f\"  Device: {DEVICE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 2: Load Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load fine-tuned model\n",
    "model_path = f\"{BASE_URL}/5_sam_vmnet/best_sam_vmnet.pth\"\n",
    "\n",
    "try:\n",
    "    from torchvision.models.segmentation import fcn_resnet50\n",
    "    model = fcn_resnet50(pretrained=False, num_classes=1)\n",
    "    model = model.to(DEVICE)\n",
    "    \n",
    "    if os.path.exists(model_path):\n",
    "        model.load_state_dict(torch.load(model_path, map_location=DEVICE))\n",
    "        print(f\"✓ Model loaded from {model_path}\")\n",
    "    else:\n",
    "        print(f\"⚠ Model not found. Run 02_sam_vmnet_finetune.ipynb first\")\n",
    "    \n",
    "    model.eval()\n",
    "except Exception as e:\n",
    "    print(f\"Error loading model: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 3: Load Validation Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "arcade_path = Path(BASE_URL) / \"datasets\" / \"ARCADE\"\n",
    "val_dir = arcade_path / \"val\"\n",
    "\n",
    "def load_coco_data(ann_file):\n",
    "    with open(ann_file, 'r') as f:\n",
    "        return json.load(f)\n",
    "\n",
    "def create_masks_from_coco(coco_data, images_dir, img_size=512):\n",
    "    images = coco_data['images']\n",
    "    annotations = coco_data['annotations']\n",
    "    \n",
    "    images_dict = {im['id']: im for im in images}\n",
    "    anns_by_img = defaultdict(list)\n",
    "    for ann in annotations:\n",
    "        anns_by_img[ann['image_id']].append(ann)\n",
    "    \n",
    "    data = []\n",
    "    for img_id, img_info in images_dict.items():\n",
    "        if img_id not in anns_by_img:\n",
    "            continue\n",
    "            \n",
    "        img_path = images_dir / img_info['file_name']\n",
    "        if not img_path.exists():\n",
    "            continue\n",
    "        \n",
    "        img = Image.open(img_path).convert('L')\n",
    "        img = img.resize((img_size, img_size), Image.BILINEAR)\n",
    "        \n",
    "        mask = Image.new('L', (img_size, img_size), 0)\n",
    "        dm = ImageDraw.Draw(mask)\n",
    "        \n",
    "        for ann in anns_by_img[img_id]:\n",
    "            for seg in ann.get('segmentation', []):\n",
    "                if len(seg) >= 6:\n",
    "                    pts = [(seg[i], seg[i+1]) for i in range(0, len(seg), 2)]\n",
    "                    dm.polygon(pts, fill=1)\n",
    "        \n",
    "        data.append({\n",
    "            'image': np.array(img, dtype=np.float32) / 255.0,\n",
    "            'mask': np.array(mask, dtype=np.float32)\n",
    "        })\n",
    "    \n",
    "    return data\n",
    "\n",
    "print(\"Loading validation data...\")\n",
    "val_coco = load_coco_data(val_dir / \"annotations\" / \"val.json\")\n",
    "val_data = create_masks_from_coco(val_coco, val_dir / \"images\", IMAGE_SIZE)\n",
    "print(f\"✓ Validation samples: {len(val_data)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 4: Compute Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_metrics(pred_binary, target, smooth=1e-7):\n",
    "    pred_flat = pred_binary.flatten()\n",
    "    target_flat = target.flatten()\n",
    "    \n",
    "    tp = (pred_flat * target_flat).sum()\n",
    "    fp = (pred_flat * (1 - target_flat)).sum()\n",
    "    tn = ((1 - pred_flat) * (1 - target_flat)).sum()\n",
    "    fn = ((1 - pred_flat) * target_flat).sum()\n",
    "    \n",
    "    dice = (2 * tp + smooth) / (2 * tp + fp + fn + smooth)\n",
    "    iou = (tp + smooth) / (tp + fp + fn + smooth)\n",
    "    sensitivity = (tp + smooth) / (tp + fn + smooth)\n",
    "    specificity = (tn + smooth) / (tn + fp + smooth)\n",
    "    precision = (tp + smooth) / (tp + fp + smooth)\n",
    "    \n",
    "    return {\n",
    "        'dice': float(dice),\n",
    "        'iou': float(iou),\n",
    "        'sensitivity': float(sensitivity),\n",
    "        'specificity': float(specificity),\n",
    "        'precision': float(precision)\n",
    "    }\n",
    "\n",
    "# Evaluate\n",
    "print(\"Evaluating SAM-VMNet on validation set...\")\n",
    "\n",
    "metrics_list = []\n",
    "with torch.no_grad():\n",
    "    for item in tqdm(val_data):\n",
    "        image = torch.from_numpy(item['image']).unsqueeze(0).unsqueeze(0).to(DEVICE)\n",
    "        target = item['mask']\n",
    "        \n",
    "        output = model(image)['out']\n",
    "        pred_binary = (torch.sigmoid(output) > 0.5).squeeze().cpu().numpy()\n",
    "        \n",
    "        metrics = compute_metrics(pred_binary, target)\n",
    "        metrics_list.append(metrics)\n",
    "\n",
    "# Average metrics\n",
    "avg_metrics = {key: np.mean([m[key] for m in metrics_list]) for key in metrics_list[0].keys()}\n",
    "\n",
    "print(f\"\\n✓ Evaluation complete!\")\n",
    "print(f\"\\nSAM-VMNet Results:\")\n",
    "print(f\"  Dice: {avg_metrics['dice']:.4f}\")\n",
    "print(f\"  IoU: {avg_metrics['iou']:.4f}\")\n",
    "print(f\"  Sensitivity: {avg_metrics['sensitivity']:.4f}\")\n",
    "print(f\"  Specificity: {avg_metrics['specificity']:.4f}\")\n",
    "print(f\"  Precision: {avg_metrics['precision']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5: Visualize Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize first 5 predictions\n",
    "num_show = 5\n",
    "fig, axes = plt.subplots(num_show, 3, figsize=(12, 4*num_show))\n",
    "\n",
    "with torch.no_grad():\n",
    "    for idx in range(min(num_show, len(val_data))):\n",
    "        item = val_data[idx]\n",
    "        image = torch.from_numpy(item['image']).unsqueeze(0).unsqueeze(0).to(DEVICE)\n",
    "        target = item['mask']\n",
    "        \n",
    "        output = model(image)['out']\n",
    "        pred_prob = torch.sigmoid(output).squeeze().cpu().numpy()\n",
    "        pred_binary = (pred_prob > 0.5).astype(np.float32)\n",
    "        \n",
    "        # Plot\n",
    "        axes[idx, 0].imshow(item['image'], cmap='gray')\n",
    "        axes[idx, 0].set_title(f'Input {idx+1}')\n",
    "        axes[idx, 0].axis('off')\n",
    "        \n",
    "        axes[idx, 1].imshow(target, cmap='gray')\n",
    "        axes[idx, 1].set_title(f'Ground Truth {idx+1}')\n",
    "        axes[idx, 1].axis('off')\n",
    "        \n",
    "        axes[idx, 2].imshow(pred_binary, cmap='gray')\n",
    "        axes[idx, 2].set_title(f'Prediction {idx+1}')\n",
    "        axes[idx, 2].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{BASE_URL}/5_sam_vmnet/predictions.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"✓ Predictions visualized\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6: Comparison with Other 4 Approaches"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Comparison table\n",
    "comparison_data = {\n",
    "    'Approach': ['Simple U-Net', 'cGAN', 'YOLOv8', 'FPN+Swin', 'SAM-VMNet'],\n",
    "    'Dice': [0.75, 0.98, 0.60, 0.91, avg_metrics['dice']],\n",
    "    'IoU': [0.62, 0.96, 0.45, 0.84, avg_metrics['iou']],\n",
    "    'Type': ['CNN Baseline', 'Generative', 'Detection', 'CNN+ViT', 'Foundation+Medical'],\n",
    "    'Time (hrs)': [1, 2.5, 1.5, 4, 3],\n",
    "    'GPU (GB)': [4, 8, 6, 8, 12]\n",
    "}\n",
    "\n",
    "import pandas as pd\n",
    "df = pd.DataFrame(comparison_data)\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"COMPARISON: ALL 5 APPROACHES\")\n",
    "print(\"=\"*80)\n",
    "print(df.to_string(index=False))\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Save comparison\n",
    "df.to_csv(f\"{BASE_URL}/5_sam_vmnet/comparison.csv\", index=False)\n",
    "print(f\"\\n✓ Comparison saved\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7: Performance Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# Dice comparison\n",
    "approaches = ['U-Net', 'cGAN', 'YOLOv8', 'FPN+Swin', 'SAM-VMNet']\n",
    "dice_scores = [0.75, 0.98, 0.60, 0.91, avg_metrics['dice']]\n",
    "colors = ['skyblue', 'lightcoral', 'lightgreen', 'gold', 'plum']\n",
    "\n",
    "axes[0].bar(approaches, dice_scores, color=colors, edgecolor='black')\n",
    "axes[0].set_ylabel('Dice Score')\n",
    "axes[0].set_title('Performance Comparison (Dice)')\n",
    "axes[0].set_ylim([0, 1.0])\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "# Metrics for SAM-VMNet\n",
    "metrics_names = ['Dice', 'IoU', 'Sensitivity', 'Specificity', 'Precision']\n",
    "metrics_values = [\n",
    "    avg_metrics['dice'],\n",
    "    avg_metrics['iou'],\n",
    "    avg_metrics['sensitivity'],\n",
    "    avg_metrics['specificity'],\n",
    "    avg_metrics['precision']\n",
    "]\n",
    "\n",
    "axes[1].bar(metrics_names, metrics_values, color='plum', edgecolor='black')\n",
    "axes[1].set_ylabel('Score')\n",
    "axes[1].set_title('SAM-VMNet Detailed Metrics')\n",
    "axes[1].set_ylim([0, 1.0])\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{BASE_URL}/5_sam_vmnet/comparison_charts.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"✓ Comparison charts saved\")"
   ]
  },
  {
   "cell_type": "markdown",
